<div class="page-heading mb-4">
  <div class="page-heading-copy">
    <span class="page-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
    <div>
      <p class="eyebrow mb-1">Kasir & Penjualan</p>
      <h1 class="h3 mb-1">Riwayat Transaksi</h1>
      <p class="text-muted mb-0">Lihat semua daftar transaksi yang telah terjadi.</p>
    </div>
  </div>
  <div class="heading-actions">
    <a href="/transactions/pos" class="btn btn-primary btn-sm"><i class="bi bi-shop" aria-hidden="true"></i> Buka Kasir (POS)</a>
  </div>
</div>

<section class="panel">
  <div class="panel-header">
    <div>
      <h2 class="h5 mb-1 section-title"><i class="bi bi-list-ul" aria-hidden="true"></i><span>Data Transaksi</span></h2>
    </div>
  </div>
  
  <div class="table-responsive">
    <table class="table align-middle mb-0 table-hover">
      <thead class="table-light">
        <tr>
          <th scope="col" width="100">ID TRX</th>
          <th scope="col">Waktu</th>
          <th scope="col">Metode Pembayaran</th>
          <th scope="col">Total</th>
          <th scope="col" class="text-end" width="100">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (transactions && transactions.length > 0) { %>
          <% transactions.forEach(trx => { %>
            <tr>
              <td><span class="badge text-bg-light border">#TRX-<%= trx.id %></span></td>
              <td>
                <% 
                  const date = new Date(trx.createdAt);
                  const formatted = date.toLocaleDateString('id-ID', {day: '2-digit', month: 'short', year: 'numeric'}) + ' ' + date.toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'});
                %>
                <%= formatted %>
              </td>
              <td><span class="badge text-bg-secondary"><%= trx.paymentMethod %></span></td>
              <td class="fw-bold text-success">Rp <%= parseFloat(trx.totalAmount).toLocaleString('id-ID') %></td>
              <td class="text-end">
                <a href="/transactions/<%= trx.id %>" class="btn btn-light btn-sm text-primary" title="Detail"><i class="bi bi-receipt"></i></a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-5 text-muted">
              <i class="bi bi-receipt fs-1 d-block mb-2"></i>
              Belum ada transaksi sama sekali.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
